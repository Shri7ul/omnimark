# ─────────────────────────────────────────────────────────────
# OmniMark — Environment blueprint
# Copy to `.env` for local development (Windows: copy .env.example .env)
# NEVER commit the real .env (it is already gitignored).
# ──────────────────────────────────────────────────────────────

# REQUIRED — TokenRouter API key that enables LLM vision / OCR / STT.
API_KEY=sk-your-tokenrouter-api-key

# Optional — override the OpenAI-compatible endpoint (sane defaults below).
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=qwen/qwen3.8-max-free

# Optional — upload ceiling in MB (default: 25). Keep ≤25 on Render Free.
MAX_UPLOAD_MB=25

# Optional — Flask secret (anything random is fine; no sessions are used).
FLASK_SECRET_KEY=change-me-to-a-long-random-string